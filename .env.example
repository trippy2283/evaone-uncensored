# Only ONE of these is required. Pick your model provider.
# OpenAI — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic (optional, for Claude) — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Which model to use by default
DEFAULT_MODEL=gpt-4o
# Other options: claude-sonnet-4-20250514, gpt-4o-mini, claude-3-5-haiku-20241022
